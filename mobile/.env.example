# Google Maps API Key for react-native-maps (Android)
#
# Required for standalone Android builds (both dev and production).
# Without this key, the app will crash on startup because
# react-native-maps uses Google Maps on Android.
#
# How to get a key:
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create a new project (or select existing)
# 3. Enable "Maps SDK for Android"
# 4. Create an API key, restrict it to Android apps
# 5. Add your app's package name: no.geonorge.tilgjengelighet
# 6. Add your app's SHA-1 certificate fingerprint
#    (for CI builds, use the debug keystore SHA-1 from GitHub Actions)
#
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
